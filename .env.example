# Environment Configuration
# Copy this file to .env and fill in your actual values
# cp .env.example .env

# ============ LLM API Keys ============
# 第5-6章 llm_api_demo.py 需要，其他实验不需要
# 国内用户推荐：DeepSeek 或阿里云百炼（兼容 OpenAI 格式，无需境外网络）

# DeepSeek（推荐，价格低，兼容 OpenAI SDK）
# 获取：https://platform.deepseek.com
DEEPSEEK_API_KEY=your-deepseek-key-here

# 阿里云百炼 / Qwen（中文强，兼容 OpenAI SDK）
# 获取：https://bailian.aliyun.com
DASHSCOPE_API_KEY=your-dashscope-key-here

# 智谱 AI / GLM（有免费额度）
# 获取：https://open.bigmodel.cn
ZHIPUAI_API_KEY=your-zhipuai-key-here

# Anthropic / Claude（需境外网络）
# 获取：https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-your-key-here

# OpenAI / GPT（需境外网络）
# 获取：https://platform.openai.com
OPENAI_API_KEY=sk-your-key-here

# ============ Hugging Face ============
# 下载开源模型时需要（公开模型可不填）
HF_TOKEN=hf_your-token-here

# 国内镜像加速（国内网络强烈推荐）
HF_ENDPOINT=https://hf-mirror.com

# 模型缓存目录（默认 ~/.cache/huggingface）
# HF_HOME=/data/models/huggingface

# ModelScope 缓存目录（使用 ModelScope 下载时）
# MODELSCOPE_CACHE=/data/models/modelscope

# ============ 实验配置 ============
# 随机种子（保证实验可复现）
RANDOM_SEED=42

# ============ GPU 配置（本地运行开源模型时）============
# GPU 设备 ID（多卡时指定）
GPU_DEVICE_ID=0

# ============ Jupyter 配置 ============
JUPYTER_PORT=8888

